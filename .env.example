# ───────────── Bot de Discord (igual que antes) ─────────────
TOKEN=
CLIENT_ID=
GUILD_ID=
ADMIN_ID=            # tu ID de usuario de Discord (recibe los MD reenviados y puede entrar al panel)
TIMEZONE=Europe/Madrid

# Estado del servidor de juegos (igual que antes)
SERVER_TYPE=MINECRAFT            # MINECRAFT | HYTALE
MINECRAFT_SERVER_IP=
MINECRAFT_SERVER_PORT=25565
MINECRAFT_API_PORT=
HYTALE_SERVER_IP=
HYTALE_API_PORT=

# ───────────── Panel web ─────────────
PANEL_ENABLED=true
PANEL_HOST=127.0.0.1             # 0.0.0.0 solo si lo expones directamente; lo normal es detrás de nginx/Caddy o túnel SSH
PANEL_PORT=3000
PANEL_URL=http://localhost:3000  # URL con la que entras al panel (sin barra final). Con dominio: https://panel.tudominio.com

# Login con Discord (OAuth2): https://discord.com/developers/applications → tu app → OAuth2
DISCORD_CLIENT_SECRET=
# En OAuth2 → Redirects añade:  <PANEL_URL>/auth/callback

# Quién puede entrar (por defecto solo ADMIN_ID)
PANEL_ADMIN_IDS=                 # IDs separados por comas
PANEL_ROLE_IDS=                  # (opcional) IDs de roles del servidor que también pueden entrar
PANEL_SESSION_HOURS=168

# Tamaño máximo por archivo subido desde el panel (MB). Discord admite 10 MB sin boost.
MAX_UPLOAD_MB=10
